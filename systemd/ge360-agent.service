[Unit]
Description=GE360 Linux Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ge360-agent
EnvironmentFile=-/etc/ge360-agent/agent.env
ExecStart=/usr/bin/python3 -m ge360_bridge.agent serve
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/ge360-agent
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
