[Unit]
Description=GE360 Bridge admin dashboard
After=network-online.target wg-quick@wg0.service ge360-bridge.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ge360-bridge
ExecStart=/usr/bin/python3 -m ge360_bridge.dashboard
Restart=always
RestartSec=2
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/ge360-bridge /etc/wireguard

[Install]
WantedBy=multi-user.target
