[Unit]
Description=GE360 Multi-server Control API
After=network-online.target ge360-bridge.service
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ge360-bridge
EnvironmentFile=-/etc/ge360-bridge/bridge.env
ExecStart=/usr/bin/python3 -m ge360_bridge.multi_server_server
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/ge360-bridge
RestrictSUIDSGID=true
LockPersonality=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
