[Unit]
Description=GE360 Bridge Optional Relay Monitor
After=network-online.target wg-quick@wg0.service ge360-bridge-enrollment.service
Wants=network-online.target
ConditionPathExists=/etc/ge360-bridge/bridge.env
ConditionPathExists=/etc/ge360-bridge/relay.token

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ge360-bridge
EnvironmentFile=-/etc/ge360-bridge/bridge.env
ExecStart=/usr/local/sbin/ge360-bridge relay-monitor
User=root
Group=root
RuntimeDirectory=ge360-bridge
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/ge360-bridge
ReadWritePaths=/run/ge360-bridge
RestrictSUIDSGID=true
LockPersonality=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
