[Unit]
Description=GE360 Optional WireGuard Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/ge360-relay
EnvironmentFile=/etc/ge360-relay/relay.env
ExecStart=/usr/bin/python3 -m ge360_bridge.relay_server
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/ge360-relay
RestrictSUIDSGID=true
LockPersonality=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
